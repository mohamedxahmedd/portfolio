---
import { profile } from '../../../data/profile.js';
import { initials } from '../../../lib/format.js';

const testimonials = profile.testimonials ?? [];
---

{
    testimonials.length > 0 && (
        <section id="testimonials" class="section bg-ink-950 relative overflow-hidden">
            <div class="orb top-1/4 right-0 size-[24rem] bg-brand-700/15" style="animation-delay: -6s" />
            <div class="container-x relative">
                <div class="text-center mb-14 reveal">
                    <p class="section-eyebrow">Kind words</p>
                    <h2 x-data="wordReveal" class="section-title">
                        What Clients <span class="text-gradient-brand">Say</span>
                    </h2>
                </div>

                <div x-data="testimonials" class="relative">
                    <div x-ref="swiper" class="overflow-hidden">
                        <div class="swiper-wrapper">
                            {testimonials.map((t) => (
                                <div class="swiper-slide pb-2 h-auto">
                                    <div x-data="cardFx(4)" class="tilt card lift glow-border h-full flex flex-col relative">
                                        <i class="fas fa-quote-left text-4xl text-brand-500/20 absolute top-4 right-4" />
                                        <div class="flex text-brand-500 gap-1 mb-3" aria-label={`${t.rating ?? 5} out of 5 stars`}>
                                            {Array.from({ length: t.rating ?? 5 }, () => <i class="fas fa-star text-sm" />)}
                                        </div>
                                        <p class="text-ink-200 leading-relaxed flex-1">"{t.quote}"</p>
                                        <div class="mt-6 flex items-center gap-3">
                                            <div class="size-12 rounded-full bg-brand-500 overflow-hidden grid place-items-center ring-2 ring-brand-500/30 font-bold text-white text-sm">
                                                {t.avatar ? <img src={t.avatar} alt={t.name} class="w-full h-full object-cover" loading="lazy" /> : <span aria-hidden="true">{initials(t.name)}</span>}
                                            </div>
                                            <div>
                                                <p class="font-semibold text-white text-sm">{t.name}</p>
                                                <p class="text-xs text-ink-400">
                                                    {t.role}
                                                    {t.company ? ` · ${t.company}` : ''}
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            ))}
                        </div>
                    </div>
                    <div class="flex items-center justify-center gap-3 mt-8">
                        <button x-ref="prev" class="size-12 grid place-items-center rounded-full border border-ink-700 hover:border-brand-500 hover:text-brand-500 hover:scale-110 transition-all duration-300" aria-label="Previous">
                            <i class="fas fa-chevron-left" />
                        </button>
                        <div x-ref="pagination" class="flex gap-2" />
                        <button x-ref="next" class="size-12 grid place-items-center rounded-full border border-ink-700 hover:border-brand-500 hover:text-brand-500 hover:scale-110 transition-all duration-300" aria-label="Next">
                            <i class="fas fa-chevron-right" />
                        </button>
                    </div>
                </div>
            </div>
        </section>
    )
}
