---
import { profile } from '../../../data/profile.js';
import { siteConfig } from '../../../config/site.js';
import { pages } from '../../../data/pages.js';
import { mailtoHref, telHref } from '../../../lib/format.js';
import { socialIcon } from '../icons.js';

const { contact } = profile;
const year = new Date().getFullYear();
---

<footer class="border-t border-ink-800 bg-ink-950 mt-20">
    <div class="container-x px-6 py-16 grid md:grid-cols-3 gap-12">
        <div>
            <a href="/" class="font-display text-2xl font-bold tracking-wider">
                {siteConfig.title}<span class="text-brand-500">.</span>
            </a>
            <p class="mt-4 text-ink-400 text-sm leading-relaxed">{siteConfig.description}</p>
            <div class="mt-6 flex flex-wrap gap-2">
                {
                    profile.socials.map((link) => (
                        <a
                            href={link.url}
                            target="_blank"
                            rel="noopener"
                            class="size-10 grid place-items-center rounded-full border border-ink-700 text-ink-300 hover:border-brand-500 hover:text-brand-500 transition"
                            aria-label={link.label}
                        >
                            <i class={socialIcon(link.platform)}></i>
                        </a>
                    ))
                }
            </div>
        </div>

        <div>
            <h4 class="font-display text-lg mb-4 uppercase tracking-wider text-brand-500">Sitemap</h4>
            <ul class="space-y-2 text-sm text-ink-300">
                <li><a href="/#about" class="hover:text-brand-500">About</a></li>
                <li><a href="/#services" class="hover:text-brand-500">Services</a></li>
                <li><a href="/projects" class="hover:text-brand-500">All Projects</a></li>
                {profile.testimonials?.length > 0 && <li><a href="/#testimonials" class="hover:text-brand-500">Testimonials</a></li>}
                <li><a href="/#contact" class="hover:text-brand-500">Contact</a></li>
                {pages.map((page) => <li><a href={`/${page.slug}`} class="hover:text-brand-500">{page.title}</a></li>)}
            </ul>
        </div>

        <div>
            <h4 class="font-display text-lg mb-4 uppercase tracking-wider text-brand-500">Get in touch</h4>
            <ul class="space-y-3 text-sm text-ink-300">
                {
                    contact.email && (
                        <li class="flex items-center gap-3">
                            <i class="fas fa-envelope text-brand-500"></i>
                            <a href={mailtoHref(contact.email)} class="hover:text-brand-500 break-all">{contact.email}</a>
                        </li>
                    )
                }
                {
                    contact.phone && (
                        <li class="flex items-center gap-3">
                            <i class="fas fa-phone text-brand-500"></i>
                            <a href={telHref(contact.phone)} class="hover:text-brand-500">{contact.phone}</a>
                        </li>
                    )
                }
                {
                    profile.location && (
                        <li class="flex items-center gap-3">
                            <i class="fas fa-map-marker-alt text-brand-500"></i>
                            <span>{profile.location}</span>
                        </li>
                    )
                }
                {
                    contact.workingHours && (
                        <li class="flex items-center gap-3">
                            <i class="fas fa-clock text-brand-500"></i>
                            <span>{contact.workingHours}</span>
                        </li>
                    )
                }
            </ul>
        </div>
    </div>

    <div class="border-t border-ink-800 py-6 px-6">
        <div class="container-x flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-ink-400">
            <span>© {year} {profile.name}. All rights reserved.</span>
            <span>Built with <span class="text-brand-500">♥</span> using Astro.</span>
        </div>
    </div>
</footer>
