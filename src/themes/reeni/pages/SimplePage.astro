---
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
    page: { slug: string; title: string; excerpt?: string; body: string };
}

const { page } = Astro.props;
---

<BaseLayout title={page.title} description={page.excerpt}>
    <article class="pt-32 pb-20 px-6">
        <div class="container-x max-w-3xl">
            <header class="mb-10">
                <h1 class="display text-4xl md:text-6xl tracking-tight">{page.title}</h1>
                {page.excerpt && <p class="mt-4 text-lg text-ink-300">{page.excerpt}</p>}
            </header>

            <div class="simple-page text-ink-200 text-lg leading-relaxed space-y-5" set:html={page.body} />
        </div>
    </article>
</BaseLayout>
