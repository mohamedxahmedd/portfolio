---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getProjects, getFilterTechnologies } from '../../../lib/portfolio.js';
import { profile } from '../../../data/profile.js';

const projects = getProjects();
const technologies = getFilterTechnologies();
const pillClass = 'pill transition-all duration-300 hover:scale-105';
---

<BaseLayout title="All Projects" description={`Flutter mobile apps and projects built by ${profile.name}.`}>
    <section class="pt-32 pb-20 px-6 relative overflow-hidden">
        <!-- Ambient background -->
        <div class="absolute inset-x-0 top-0 h-[60vh] -z-10 pointer-events-none">
            <div class="orb top-0 -right-40 size-[36rem] bg-brand-500/15"></div>
            <div class="orb top-1/3 -left-40 size-[24rem] bg-brand-700/10" style="animation-delay: -5s"></div>
        </div>

        <div class="container-x">
            <header class="reveal text-center mb-14 max-w-3xl mx-auto">
                <p class="section-eyebrow">Portfolio</p>
                <h1 x-data="wordReveal" class="display text-5xl md:text-7xl tracking-tight">Mobile apps & <span class="text-gradient-brand">projects</span></h1>
                <p class="mt-4 text-ink-300">Flutter apps shipped to the App Store and Google Play, plus open-source experiments.</p>
            </header>

            {
                technologies.length > 0 && (
                    <div class="reveal flex flex-wrap items-center justify-center gap-2 mb-10">
                        <a href="/projects" data-tech-filter="all" class={`${pillClass} bg-brand-500 text-white border-brand-500`}>All</a>
                        {technologies.map((tech) => (
                            <a href={`/projects?tech=${tech.slug}`} data-tech-filter={tech.slug} class={pillClass}>
                                {tech.name}
                            </a>
                        ))}
                    </div>
                )
            }

            <p data-projects-empty hidden class="text-center text-ink-400 py-20">No projects found for this filter.</p>

            {
                projects.length === 0 ? (
                    <p class="text-center text-ink-400 py-20">No projects yet.</p>
                ) : (
                    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 stagger">
                        {projects.map((project) => <ProjectCard project={project} />)}
                    </div>
                )
            }
        </div>
    </section>
</BaseLayout>
