---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectPlaceholder from '../components/ProjectPlaceholder.astro';
import { getRelatedProjects } from '../../../lib/portfolio.js';
import { paragraphs } from '../../../lib/format.js';

interface Props {
    project: any;
}

const { project } = Astro.props;
const related = getRelatedProjects(project);
const eyebrow = [project.year, project.platform ?? 'Mobile'].filter(Boolean).join(' · ');
const details = [
    ['Client', project.client],
    ['Role', project.role],
    ['Duration', project.duration],
    ['Year', project.year],
    ['Platform', project.platform],
].filter(([, value]) => value);
const hasLinks = project.appStoreUrl || project.playStoreUrl || project.githubUrl || project.liveUrl;
---

<BaseLayout title={project.title} description={project.shortDescription} image={project.thumbnail}>
    <article class="pt-32 relative">
        <!-- Ambient background -->
        <div class="absolute inset-x-0 top-0 h-[60vh] -z-10 overflow-hidden pointer-events-none">
            <div class="orb top-0 -right-40 size-[40rem] bg-brand-500/15"></div>
            <div class="orb top-1/3 -left-40 size-[30rem] bg-brand-700/10" style="animation-delay: -5s"></div>
        </div>

        <!-- Hero -->
        <header class="px-6 py-16">
            <div class="container-x max-w-5xl">
                <a href="/projects" class="inline-flex items-center gap-2 text-sm text-ink-400 hover:text-brand-500 mb-8 transition group">
                    <i class="fas fa-arrow-left group-hover:-translate-x-1 transition-transform"></i> All projects
                </a>

                <div class="reveal">
                    <p class="section-eyebrow">{eyebrow}</p>
                    <h1 x-data="wordReveal" class="display text-4xl md:text-7xl tracking-tight break-words">{project.title}</h1>
                    {project.subtitle && <p class="mt-3 text-xl text-ink-300">{project.subtitle}</p>}

                    <p class="mt-6 text-lg text-ink-300 max-w-3xl leading-relaxed">{project.shortDescription}</p>
                </div>

                <!-- Store + repo links -->
                {
                    hasLinks && (
                        <div class="reveal stagger mt-8 flex flex-wrap gap-3">
                            {project.appStoreUrl && (
                                <a href={project.appStoreUrl} target="_blank" rel="noopener" class="btn-primary" x-data="magnetic(0.18)">
                                    <span class="flex items-center gap-2">
                                        <i class="fab fa-apple text-xl" />
                                        <span class="text-left leading-tight">
                                            <span class="block text-xs font-normal opacity-80">Download on the</span>
                                            <span class="block">App Store</span>
                                        </span>
                                    </span>
                                </a>
                            )}
                            {project.playStoreUrl && (
                                <a href={project.playStoreUrl} target="_blank" rel="noopener" class="btn-primary" x-data="magnetic(0.18)">
                                    <span class="flex items-center gap-2">
                                        <i class="fab fa-google-play text-xl" />
                                        <span class="text-left leading-tight">
                                            <span class="block text-xs font-normal opacity-80">Get it on</span>
                                            <span class="block">Google Play</span>
                                        </span>
                                    </span>
                                </a>
                            )}
                            {project.githubUrl && (
                                <a href={project.githubUrl} target="_blank" rel="noopener" class="btn-ghost" x-data="magnetic(0.15)">
                                    <span>
                                        <i class="fab fa-github" /> View source
                                    </span>
                                </a>
                            )}
                            {project.liveUrl && (
                                <a href={project.liveUrl} target="_blank" rel="noopener" class="btn-ghost" x-data="magnetic(0.15)">
                                    <span>
                                        <i class="fas fa-globe" /> Live demo
                                    </span>
                                </a>
                            )}
                        </div>
                    )
                }
            </div>
        </header>

        <!-- Cover -->
        <div class="reveal reveal-scale container-x px-6 mb-16">
            <div class="img-zoom rounded-3xl overflow-hidden aspect-[16/8]">
                {
                    project.thumbnail ? (
                        <img src={project.thumbnail} alt={project.title} fetchpriority="high" class="rounded-3xl w-full h-full object-cover img-blur-up" x-data="imgLoad" />
                    ) : (
                        <ProjectPlaceholder title={project.title} subtitle={project.subtitle} class="rounded-3xl" />
                    )
                }
            </div>
        </div>

        <!-- Meta + Description -->
        <div class="container-x px-6 max-w-5xl grid lg:grid-cols-[1fr_260px] gap-10 mb-16">
            <div class="reveal max-w-none text-ink-300 leading-relaxed">
                {project.description && <div class="space-y-5">{paragraphs(project.description).map((p) => <p>{p}</p>)}</div>}

                {
                    project.problem && (
                        <>
                            <h3 class="font-display text-2xl text-white mt-10 mb-3">The problem</h3>
                            <p class="text-ink-300 leading-relaxed">{project.problem}</p>
                        </>
                    )
                }

                {
                    project.solution && (
                        <>
                            <h3 class="font-display text-2xl text-white mt-8 mb-3">The solution</h3>
                            <p class="text-ink-300 leading-relaxed">{project.solution}</p>
                        </>
                    )
                }

                {
                    project.features.length > 0 && (
                        <>
                            <h3 class="font-display text-2xl text-white mt-10 mb-4">Key features</h3>
                            <ul class="grid sm:grid-cols-2 gap-3 list-none p-0">
                                {project.features.map((feature: string) => (
                                    <li class="flex items-start gap-3 text-ink-300">
                                        <i class="fas fa-check-circle text-brand-500 mt-1" />
                                        <span>{feature}</span>
                                    </li>
                                ))}
                            </ul>
                        </>
                    )
                }
            </div>

            <aside class="reveal reveal-right space-y-4">
                {
                    details.length > 0 && (
                        <div class="card lift text-sm">
                            <h4 class="font-display text-base mb-4 uppercase tracking-wider text-brand-500">Project details</h4>
                            <dl class="space-y-3">
                                {details.map(([label, value]) => (
                                    <div class="flex justify-between gap-3">
                                        <dt class="text-ink-400">{label}</dt>
                                        <dd class="text-white text-right">{value}</dd>
                                    </div>
                                ))}
                            </dl>
                        </div>
                    )
                }

                {
                    project.technologies.length > 0 && (
                        <div class="card lift text-sm">
                            <h4 class="font-display text-base mb-4 uppercase tracking-wider text-brand-500">Tech stack</h4>
                            <div class="flex flex-wrap gap-2">
                                {project.technologies.map((tech: any) => (
                                    <a href={`/projects?tech=${tech.slug}`} class="pill hover:border-brand-500 hover:text-brand-500 transition-colors">
                                        {tech.name}
                                    </a>
                                ))}
                            </div>
                        </div>
                    )
                }
            </aside>
        </div>

        <!-- Screenshots gallery -->
        {
            project.images.length > 0 && (
                <section class="bg-ink-950 py-16 px-6 relative overflow-hidden">
                    <div class="orb top-0 right-0 size-[24rem] bg-brand-500/10" />
                    <div class="container-x relative">
                        <div class="reveal text-center">
                            <p class="section-eyebrow">Screens</p>
                            <h2 x-data="wordReveal" class="section-title mb-10">
                                Inside the <span class="text-gradient-brand">app</span>
                            </h2>
                        </div>

                        <div class="grid grid-cols-2 lg:grid-cols-3 gap-4 stagger" x-data="{ open: false, src: '' }">
                            {project.images.map((shot: string, i: number) => (
                                <button
                                    type="button"
                                    data-src={shot}
                                    x-on:click="open = true; src = $el.dataset.src"
                                    class="img-zoom group relative overflow-hidden rounded-2xl bg-ink-800 aspect-[9/16] border border-ink-700 hover:border-brand-500 transition-colors"
                                    aria-label={`Open screenshot ${i + 1}`}
                                >
                                    <img src={shot} alt={`${project.title} screenshot ${i + 1}`} loading="lazy" decoding="async" class="w-full h-full object-cover" />
                                    <div class="absolute inset-0 bg-gradient-to-t from-ink-950/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 grid place-items-end p-4">
                                        <span class="size-10 rounded-full bg-brand-500 grid place-items-center text-white">
                                            <i class="fas fa-expand" />
                                        </span>
                                    </div>
                                </button>
                            ))}

                            <div
                                x-show="open"
                                x-cloak
                                x-on:keydown.escape.window="open = false"
                                x-transition.opacity.duration.300ms
                                class="fixed inset-0 z-50 bg-ink-950/95 backdrop-blur grid place-items-center p-6"
                                x-on:click.self="open = false"
                            >
                                <button x-on:click="open = false" class="absolute top-6 right-6 size-12 grid place-items-center rounded-full bg-ink-800 text-white hover:bg-brand-500 hover:rotate-90 transition-all duration-300" aria-label="Close">
                                    <i class="fas fa-times text-xl" />
                                </button>
                                <img x-bind:src="src" alt="" class="max-h-[90vh] max-w-full rounded-2xl shadow-2xl" x-transition.scale.duration.300ms />
                            </div>
                        </div>
                    </div>
                </section>
            )
        }

        <!-- Related projects -->
        {
            related.length > 0 && (
                <section class="section">
                    <div class="container-x">
                        <h2 x-data="wordReveal" class="section-title mb-10">
                            Related <span class="text-gradient-brand">projects</span>
                        </h2>
                        <div class="grid md:grid-cols-3 gap-6 stagger">
                            {related.map((other) => (
                                <a href={other.url} x-data="cardFx(5)" data-cursor-text="View →" class="tilt card lift glow-border p-0 overflow-hidden group block">
                                    <div class="img-zoom aspect-[4/3] bg-ink-800 overflow-hidden">
                                        {other.thumbnail ? (
                                            <img src={other.thumbnail} alt={other.title} class="w-full h-full object-cover img-blur-up" x-data="imgLoad" loading="lazy" decoding="async" />
                                        ) : (
                                            <ProjectPlaceholder title={other.title} subtitle={other.subtitle} />
                                        )}
                                    </div>
                                    <div class="p-5 tilt-inner">
                                        <h3 class="font-display text-lg text-white group-hover:text-brand-500 transition-colors duration-300">{other.title}</h3>
                                        <p class="text-sm text-ink-400 line-clamp-2 mt-2">{other.shortDescription}</p>
                                    </div>
                                </a>
                            ))}
                        </div>
                    </div>
                </section>
            )
        }
    </article>
</BaseLayout>
