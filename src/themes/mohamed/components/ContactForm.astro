---
/* Static contact form in the template's own form style — see src/lib/contact-form.js. */
import { profile } from '../../../data/profile.js';
import { siteConfig } from '../../../config/site.js';
---

<div data-contact>
    <div data-contact-success hidden class="contact-success">
        <div data-success-text="endpoint">
            <h4 class="fw-medium">Message sent!</h4>
            <p class="text-body-2">Thanks for reaching out — I'll respond within 24 hours.</p>
        </div>
        <div data-success-text="mailto">
            <h4 class="fw-medium">Almost there!</h4>
            <p class="text-body-2">Your email app should now be open with your message ready — just hit send. Didn't open? <a data-contact-mailto href={`mailto:${profile.contact.email}`}>Click here</a> or write to {profile.contact.email}.</p>
        </div>
        <button type="button" data-contact-reset class="text-body-1 link">Send another <i class="icon icon-arrow-top-right"></i></button>
    </div>

    <form class="form-contact" data-contact-form data-email={profile.contact.email} data-endpoint={siteConfig.contactForm.endpoint ?? ''}>
        <fieldset class="fiel-name">
            <label for="contact-name">Your name *</label>
            <input id="contact-name" name="name" type="text" placeholder="John Doe" required autocomplete="name" />
        </fieldset>
        <fieldset class="fiel-mail">
            <label for="contact-email">Email address *</label>
            <input id="contact-email" name="email" type="email" placeholder="you@example.com" required autocomplete="email" />
        </fieldset>
        <fieldset class="fiel-phone">
            <label for="contact-phone">Phone</label>
            <input id="contact-phone" name="phone" type="tel" placeholder="Optional" autocomplete="tel" />
        </fieldset>
        <fieldset class="fiel-subject">
            <label for="contact-subject">Subject</label>
            <input id="contact-subject" name="subject" type="text" placeholder="Optional" />
        </fieldset>
        <fieldset class="fiel-text">
            <label for="contact-message">Message *</label>
            <textarea id="contact-message" name="message" placeholder="Tell me about your project…" required></textarea>
        </fieldset>

        <!-- Honeypot -->
        <div class="d-none" aria-hidden="true">
            <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
        </div>

        <div class="bot-btn">
            <button type="submit" data-contact-submit>
                <span class="text-body-1" data-state="idle">Send message</span>
                <span class="text-body-1" data-state="sending" hidden>Sending…</span>
                <i class="icon icon-arrow-top-right"></i>
            </button>
        </div>
    </form>
</div>
